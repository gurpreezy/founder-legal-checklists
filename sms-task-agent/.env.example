# Claude API
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SCREENSHOT_BUCKET=screenshots

# Twilio (Console -> Account Info)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Optional: only accept messages from these numbers (comma-separated, E.164)
ALLOWED_SENDERS=+15551234567
# Set to false only for local testing without real Twilio signatures
VALIDATE_TWILIO_SIGNATURE=true

# Dashboard
DASHBOARD_API_KEY=generate-a-long-random-string

# Used to resolve relative due dates like "Friday"
USER_TIMEZONE=America/Los_Angeles
